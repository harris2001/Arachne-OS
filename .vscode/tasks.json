{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run QEMU GDB",
            "type": "shell",
            "command": "make",
            "args": [
                "run-gdb"
            ],
            "isBackground": true,
            "problemMatcher": [
                {
                    "pattern": {
                        "regexp": "^.*$",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*gdb.*",
                        "endsPattern": ".*localhost:1234.*"
                    }
                }
            ]
        }
    ]
}   